NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_APP_NAME="Chess Platform"

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KBDN0KSR0N
# Set to "true" to load GA and see hits in GA4 DebugView while running `next dev` locally.
# Leave unset/false in local dev so local traffic never pollutes production GA data —
# GA still loads automatically in production regardless of this flag.
NEXT_PUBLIC_GA_DEBUG=false
